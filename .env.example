# Copie para .env e preencha.
PORT=3000

# Senha do painel /admin (use algo longo e aleatório).
ADMIN_TOKEN=

# Número que recebe os agendamentos (DDI + DDD + número).
WHATSAPP_NUMBER=554832429297

# Opcional: URL que recebe um POST a cada novo pedido
# (Make, Zapier, n8n, Slack, Discord ou Google Chat).
LEAD_WEBHOOK_URL=

# Use 1 quando o site estiver atrás de proxy/CDN (Cloudflare, Nginx, Render…).
TRUST_PROXY=0

NODE_ENV=production

# Só para hospedar fora da Vercel com Upstash Redis (na Vercel, a integração
# Storage → Upstash cria KV_REST_API_URL e KV_REST_API_TOKEN sozinha).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
